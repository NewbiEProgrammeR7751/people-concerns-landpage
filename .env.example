# ── GitHub "Recent Activity" widget ────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in. These are SERVER-ONLY: they are read
# by api/github-activity.ts inside the function runtime. Do NOT add the VITE_
# prefix to any of them — that would inline the value into the client bundle and
# publish your token.

# Fine-grained PAT, read-only. Required — the route returns 500 "not_configured"
# without it (and the widget falls back to its static events).
# Repository permissions to grant:
#   - Public repo  → "Metadata: Read-only" is enough. Authenticating still raises
#                    the rate limit from 60 to 5,000 req/hr, which is why it is
#                    required rather than optional.
#   - Private repo → "Contents: Read-only" (Metadata is added implicitly).
# Never grant write scopes; this endpoint only reads.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# The repository whose events feed the widget.
# For https://github.com/people-concerns/platform →
GITHUB_OWNER=people-concerns
GITHUB_REPO=platform

# ── "Concern received" confirmation email ──────────────────────────────────
# Read by api/concern-received.ts inside the function runtime. SERVER-ONLY: do
# NOT add the VITE_ prefix to any of them, or the value lands in the client
# bundle. The route returns 500 "not_configured" until RESEND_API_KEY is set.

# Resend API key — https://resend.com/api-keys. The sending domain must be
# verified in Resend before mail to external addresses is delivered.
# To use a different provider, rewrite `sendEmail()` in api/concern-received.ts;
# it is the only function that touches the provider.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Absolute origin of the deployed site. Every URL in the email is built from
# this, including the header logo at /email-assets/pc-logo-horizontal-ondark@2x.png
# — mail clients cannot resolve relative paths, so a wrong value means a broken
# logo. No trailing slash; only the origin is used.
PUBLIC_SITE_URL=https://www.peopleconcerns.com

# Optional. Envelope sender. Must be on a domain verified in Resend.
# Defaults to "People Concerns <NoReply@peopleconcerns.com>".
CONCERN_FROM_EMAIL=People Concerns <NoReply@peopleconcerns.com>

# Optional but recommended. Where the submission itself is forwarded, so the
# enquiry reaches a human and not only the sender's inbox. Reply-To is set to
# the person who wrote in, so replying answers them directly. Unset = the
# confirmation is still sent, but nothing is delivered to the team.
CONCERNS_INBOX_EMAIL=support@peopleconcerns.com

# Optional. Template for the "Track your concern" button in the email;
# `{reference}` is substituted. Point this at the member platform once concern
# tracking exists. Unset = the button links to PUBLIC_SITE_URL/#contact.
CONCERN_TRACKING_URL=https://www.peopleconcerns.com/concerns/{reference}
